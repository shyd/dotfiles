#! /usr/bin/env zsh
mime=$(file -bL --mime-type "$1")
category=${mime%%/*}
kind=${mime##*/}
if [ -d "$1" ]; then
    #eza --git -hl --color=always --icons "$1"

    if command -v eza 2>&1 >/dev/null; then
        eza --color-scale -h --no-permissions --octal-permissions --git --icons --tree -L 2 "$1"
    else
        # fallback to normal ls
        ls "$1"
    fi
elif [ "$category" = image ]; then
    chafa -c 240 -s 80x25 "$1"
    exiftool "$1"
elif [ "$kind" = vnd.openxmlformats-officedocument.spreadsheetml.sheet ] || \
    [ "$kind" = vnd.ms-excel ]; then
    in2csv "$1" | xsv table | bat -ltsv --color=always
elif [ "$category" = text ]; then
    bat --color=always "$1"
else
    if command -v lesspipe.sh >/dev/null 2>&1; then
        lesspipe.sh "$1" | bat --color=always
    elif command -v lesspipe >/dev/null 2>&1; then
        lesspipe "$1" | bat --color=always
    else
        file "$1" | bat --color=always
    fi
fi
# lesspipe does not use eza, bat, or chafa, so this filter provides previews.
